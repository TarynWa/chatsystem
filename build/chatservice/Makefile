gen/auth.pb.i: gen/auth.pb.cc.i
.PHONY : gen/auth.pb.i

# target to preprocess a source file
gen/auth.pb.cc.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/chatauth_proto.dir/build.make CMakeFiles/chatauth_proto.dir/gen/auth.pb.cc.i
.PHONY : gen/auth.pb.cc.i

gen/auth.pb.s: gen/auth.pb.cc.s
.PHONY : gen/auth.pb.s

# target to generate assembly for a file
gen/auth.pb.cc.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/chatauth_proto.dir/build.make CMakeFiles/chatauth_proto.dir/gen/auth.pb.cc.s
.PHONY : gen/auth.pb.cc.s

